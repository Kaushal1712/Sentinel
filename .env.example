# Sentinel — Digital Footprint & Exposure Intelligence Platform
# Environment configuration template.
# Copy this file to .env and fill in your values. Never commit .env to source control.

# ── AI Engine ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Core Security ──────────────────────────────────────────────────────────────
# Generate strong random values, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# IMPORTANT: The placeholder values below are EXPLICITLY REJECTED when
# APP_ENV=production. The application will refuse to start if these default
# strings are still set in any production environment.
SECRET_KEY=change-this-in-production
JWT_SECRET_KEY=change-this-jwt-key-in-production

# Set to true in production to enforce the Secure flag on JWT cookies.
# This is automatically set to true in docker-compose.yaml for dfas-web.
# Set to false only for local HTTP development.
JWT_COOKIE_SECURE=false

# Application environment signal.
# "development" (default) — no secret enforcement; works without real secrets.
# "production"            — validate_secrets() enforces strong SECRET_KEY and
#                           JWT_SECRET_KEY at application startup.
# Pre-set to "production" automatically in docker-compose.yaml for all services.
APP_ENV=development

# ── Observability ──────────────────────────────────────────────────────────────
# Bearer token required to access GET /metrics (Prometheus scrape endpoint).
# If not set (or empty), /metrics returns 404 — prevents accidental public exposure.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Then add to prometheus.yml:
#   bearer_token: <your token>
METRICS_TOKEN=


# ── PostgreSQL credentials (Docker Compose stack) ─────────────────────────────
# Used by docker-compose.yaml for the db service and the DATABASE_URL of all
# Compose services.  Not needed for local SQLite development.
# Generate a strong random value:
#   python3 -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_USER=dfas
POSTGRES_DB=dfas

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (local dev)
DATABASE_URL=sqlite:///footprint.db
# PostgreSQL (Docker Compose / production) — password must match POSTGRES_PASSWORD above
# DATABASE_URL=postgresql://dfas:${POSTGRES_PASSWORD}@db:5432/dfas

# ── Task Queue (Celery + Redis) ────────────────────────────────────────────────
TASK_QUEUE_ENABLED=false
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Task time limits (seconds). Soft limit raises SoftTimeLimitExceeded (catchable);
# hard limit sends SIGKILL. Defaults: 30 min soft / 35 min hard.
CELERY_TASK_SOFT_TIME_LIMIT=1800
CELERY_TASK_TIME_LIMIT=2100
# Per-request timeout for external intelligence API calls during enrichment (seconds).
ENRICHMENT_TIMEOUT=30

# ── SearxNG (OSINT search engine) ─────────────────────────────────────────────
SEARXNG_URL=http://localhost:8888/search
SEARXNG_ENABLED=false
SEARXNG_TIME_RANGE=month

# ── Authentication ─────────────────────────────────────────────────────────────
SELF_SCAN_ONLY=true
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=10

# ── Google OAuth2 / OpenID Connect ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OSINT Plugin API Keys (all optional — plugins skip gracefully if absent) ───
SHODAN_API_KEY=
NUMVERIFY_API_KEY=
HUNTER_API_KEY=
CLEARBIT_API_KEY=
INTELX_API_KEY=
GOOGLE_VISION_KEY=
PIMEYES_API_KEY=
HIBP_API_KEY=

# ── Nitter instances for Twitter/X scraping ────────────────────────────────────
NITTER_INSTANCES=nitter.net,nitter.poast.org

# ── Dataset Upload ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=16
MAX_DATASET_ROWS=10000
# Maximum number of columns in an uploaded dataset (rejects wider files immediately).
MAX_DATASET_COLUMNS=500
# Maximum number of datasets a single user may hold (enforced via COUNT query).
MAX_DATASETS_PER_USER=20
# Maximum character length for the user-supplied dataset description.
MAX_DATASET_DESCRIPTION_LENGTH=1000

# ── Rate Limiting ───────────────────────────────────────────────────────────────
# Default: in-memory storage — works without Redis, resets on every restart,
# and does NOT share counters across Gunicorn workers.  Suitable for local
# development only.
#
# Production (APP_ENV=production): validate_secrets() REJECTS memory:// at
# startup so that a misconfigured deployment fails clearly rather than silently
# providing per-worker (ineffective) rate limiting.  You must set a shared
# backend.  The docker-compose.yaml already configures dfas-web, dfas-worker,
# and dfas-beat correctly:
#   RATELIMIT_STORAGE_URI=redis://redis:6379/1
#
# Uses Redis DB 1 to avoid collision with Celery's DB 0.
RATELIMIT_STORAGE_URI=memory://

# Per-user rate limits for expensive dataset endpoints.
# Values use Flask-Limiter format: "<count> per <period>" (e.g. "10 per hour").
# Keyed by authenticated user ID — different users behind the same IP are
# counted independently.
DATASET_UPLOAD_RATE_LIMIT=10 per hour
DATASET_CHAT_RATE_LIMIT=30 per hour
DATASET_INSIGHTS_RATE_LIMIT=10 per hour

# ── Admin Bootstrap (create_admin.py) ──────────────────────────────────────────
# Used only by the one-time create_admin.py bootstrap script.
# If ADMIN_INITIAL_PASSWORD is not set, the script will prompt interactively.
# Never commit a real password here.
ADMIN_EMAIL=admin@sentinel.local
ADMIN_INITIAL_PASSWORD=
