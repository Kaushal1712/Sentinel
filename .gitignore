# =============================================================
# DFAS / Data-Atlas — .gitignore
# =============================================================

# ── Secrets & Environment Variables ──────────────────────────
.env
.env.*
# Keep the safe template committed
!.env.example

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/
.mypy_cache/
.dmypy.json
.pyre/
.ruff_cache/

# ── Virtual Environments ──────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Database & Persistent Storage ────────────────────────────
*.db
*.db-*
*.sqlite
*.sqlite3
backend/footprint.db
backend/instance/
backend/evidence/
backend/uploads/

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
backend/*.log
backend/run.out.log
backend/run.err.log
backend/server.log
backend/server.out.log
backend/server.err.log
backend/test.log
backend/test_results.log
build.log

# ── Test & Coverage ───────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
pytest.ini.bak

# ── Frontend / Node ───────────────────────────────────────────
frontend/node_modules/
node_modules/
.npm/
.yarn/
# TypeScript incremental build cache — generated, not source
*.tsbuildinfo


# ── Build Artifacts ───────────────────────────────────────────
dist/
build/
*.spec.bak
dfas.spec

# ── Docker ────────────────────────────────────────────────────
# (docker-compose.yaml itself is committed; override files are not)
docker-compose.override.yml
docker-compose.local.yml

# ── IDE & Editor ─────────────────────────────────────────────
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ── OS Generated ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Misc ─────────────────────────────────────────────────────
*.bak
*.tmp
*.orig
test_data.csv
